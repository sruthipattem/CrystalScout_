# Safe default: production requires a genuine secret before startup.
CRYSTALSCOUT_ENV=production
CRYSTALSCOUT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MP_API_KEY=REPLACE_WITH_YOUR_MATERIALS_PROJECT_API_KEY

# Local development only: set CRYSTALSCOUT_ENV=development and leave
# CRYSTALSCOUT_SECRET_KEY empty to enable the documented development fallback.
# Never use development mode or the fallback in production. Never commit .env.
